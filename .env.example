# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Chave secreta: só no servidor. Nunca coloque no navegador nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Nome que aparece no topo dos pedidos e do romaneio
NEXT_PUBLIC_EMPRESA_NOME=Minha Distribuidora
